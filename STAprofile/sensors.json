{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "value": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@iot.selfLink": { "type": "string", "format": "uri" },
          "@iot.id": { "type": "integer" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "encodingType": { "type": "string", "const":"application/json" },
          "metadata": { "type": "string", "format": "uri" },
          "properties": {
            "type": "object",
            "properties": {
              "sdo:category": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "@type": { "type": "string", "const":"DefinedTerm" },
                  "termCode": { "type": "string" },
                  "identifier": { "type": "string", "format": "uri" },
                  "inDefinedTermSet": { "type": "string", "enum": ["http://vocab.nerc.ac.uk/collection/L05/current/"] }    
                },
                "required": ["name", "termCode", "identifier", "inDefinedTermSet"]
              },
              "calibration": {
                "type": "object",
                "properties": {
                  "rawUnit": { "type": "string" },
                  "description": { "type": "string" },
                  "convertedUnit": { "type": "string" },
                  "conversionFormula": { "type": "string" }
                }
               
              },
              "sdo:manufacturer": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "@type": { "type": "string", "const":"DefinedTerm" },
                  "termCode": { "type": "string" },
                  "identifier": { "type": "string", "format": "uri" },
                  "inDefinedTermSet": { "type": "string", "enum": ["http://vocab.nerc.ac.uk/collection/L35/current/"] }                },
               
              },
              "sosa:hasPropertyValue": {
                "type": "array",
                "properties": {
                  "max": { "type": "number" },
                  "min": { "type": "number" },
                  "@type": { "type": "string", "const":"sosa:MeasurementRange" },
                  "unitOfMeasurement": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string" },
                      "symbol": { "type": "string" },
                      "definition": { "type": "string", "format": "uri" }
                    },
                   
                  }
                }
              },
              "sdo:model": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "@type": { "type": "string", "const":"DefinedTerm" },
                  "termCode": { "type": "string" },
                  "identifier": { "type": "string", "format": "uri" },
                 "inDefinedTermSet": { "type": "string", "enum": ["http://vocab.nerc.ac.uk/collection/L22/current/"] }


                },
                "required": ["name", "termCode", "identifier", "inDefinedTermSet"]
              },
              "identifier": {
                "type": "object",
                "properties": {
                  "@id": { "type": "string", "format": "uri" },
                  "@type": { "type": "string" },
                  "value": { "type": "string" },
                  "propertyID": { "type": "string", "enum": ["http://b2inst.gwdg.de/records/"] }

                },
                "required": ["@id", "@type", "value", "propertyID"]
              },
              "sdo:serialNumber": { "type": "string" }
            },
            "required": [ "sdo:model", "identifier"]
          },
          "Datastreams@iot.navigationLink": { "type": "string", "format": "uri" }
        },
        "required": ["@iot.selfLink", "@iot.id", "name", "description", "encodingType", "metadata",  "Datastreams@iot.navigationLink"]
      }
    }
  },
  "required": ["value"]
}

