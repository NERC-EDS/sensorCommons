{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "value": {
      "type": "array",
      "items": [
        {
          "type": "object",
          "properties": {
            "@iot.selfLink": {
              "type": "string"
            },
            "@iot.id": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "properties": {
              "type": "object",
              "properties": {
                "category": {
                  "type": "object",
                  "properties": {
                    "@id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "@type": { "type": "string",  "enum": ["sdo:CategoryCode"]  },

                    "termCode": {
                      "type": "string"
                    },
                    "inDefinedTermSet": {
                      "type": "string",  "enum":["http://vocab.nerc.ac.uk/collection/L06/current/"]
                    }
                  },
                  "required": [
                    "@id",
                    "name",
                    "@type",
                    "termCode",
                    "inDefinedTermSet"
                  ]
                },
                "identifier": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "@type": {
                      "type": "string"
                    },
                    "termCode": {
                      "type": "string"
                    },
                    "identifier": {
                      "type": "string"
                    },
                    "inDefinedTermSet": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "@type",
                    "termCode",
                    "identifier",
                    "inDefinedTermSet"
                  ]
                },
                "provider": {
                  "type": "object",
                  "properties": {
                    "@id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "@type": { "type": "string",  "enum": ["sdo:Organization"]  },

                    "identifier": {
                      "type": "object",
                      "properties": {
                        "@type": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        },
                    "propertyID": { "type": "string", "enum": ["http://registry.identifiers.org/registry/ror"] }

                      },
                      "required": [
                        "@type",
                        "value",
                        "propertyID"
                      ]
                    }
                  },
                  "required": [
                    "@id",
                    "name",
                    "@type",
                    "identifier"
                  ]
                }
              },
              "required": [
               
                "identifier",
                "provider"
              ]
            },
            "HistoricalLocations@iot.navigationLink": {
              "type": "string"
            },
            "Locations@iot.navigationLink": {
              "type": "string"
            },
            "Datastreams@iot.navigationLink": {
              "type": "string"
            }
          },
          "required": [
            "@iot.selfLink",
            "@iot.id",
            "name",
            "description",
            "properties"
          ]
        }
      ]
    }
  },
  "required": [
    "value"
  ]
}
