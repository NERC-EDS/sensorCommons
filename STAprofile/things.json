{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "value": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "@iot.selfLink": { "type": "string", "format": "uri" },
          "@iot.id": { "type": "integer" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "properties": {
            "type": "object",
            "properties": {
              "sdo:provider": {
                "type": "object",
                "properties": {
                  "@id": { "type": "string", "format": "uri" },
                  "name": { "type": "string" },
                  "@type": { "type": "string" ,"enum": ["PropertyValue"] },
                  "value": { "type": "string" },
                  "propertyID": { "type": "string", "enum": ["http://registry.identifiers.org/registry/ror"] }


                },
                "required": ["@id", "name", "@type", "value", "propertyID"]
              },
              "sdo:category": {
                "type": "object",
                "properties": {
                  "@type": { "type": "string","enum": ["DefinedTerm"] },
                  "name": { "type": "string" },
                  "termCode": { "type": "string" },
                  "identifier": { "type": "string", "format": "uri" },
                  "inDefinedTermSet": { "type": "string", "const": "http://vocab.nerc.ac.uk/collection/L06/current/" }


                },
                "required": ["name", "termCode", "identifier", "inDefinedTermSet"]
              },
              "sdo:identifier": {
                "type": "object",
                "properties": {
                  "@id": { "type": "string" },
                  "@type": { "type": "string" },
                  "value": { "type": "string" },
                  "propertyID": { "type": "string" }

                },
                "required": ["@id", "@type", "value", "propertyID"]
              }
            },
          
          },
          "HistoricalLocations@iot.navigationLink": { "type": "string", "format": "uri" },
          "Locations@iot.navigationLink": { "type": "string", "format": "uri" },
          "Datastreams@iot.navigationLink": { "type": "string", "format": "uri" }
        },
        "required": ["@iot.selfLink", "@iot.id", "name", "description", "HistoricalLocations@iot.navigationLink", "Locations@iot.navigationLink", "Datastreams@iot.navigationLink"]
      }
    }
  },
  "required": ["value"]
}
